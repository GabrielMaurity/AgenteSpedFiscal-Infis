root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,slnx}]
indent_size = 2

[*.ps1]
end_of_line = crlf

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = true:suggestion
dotnet_sort_system_directives_first = true

# Aplicação web: sem SynchronizationContext e sem gerador de LoggerMessage.
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# Nullable habilitado já cobre os argumentos públicos.
dotnet_diagnostic.CA1062.severity = none
# Vocabulário do domínio em português.
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1707.severity = none
# Assemblies internos de serviço, sem API pública versionada.
dotnet_diagnostic.CA1515.severity = none
# Exceções de domínio com construtor único, sempre com motivo.
dotnet_diagnostic.CA1032.severity = none

# Código gerado pelo dotnet ef.
[**/Migracoes/*.cs]
dotnet_diagnostic.CA1861.severity = none
