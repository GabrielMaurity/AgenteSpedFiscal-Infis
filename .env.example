# Copie para .env e preencha. O arquivo .env não é versionado (constitution P-19).

# OpenAI
OPENAI_API_KEY=
# Modelo de análise: definido em docs/adr/0003-modelo-de-analise.md após os evals.
OPENAI_MODELO_ANALISE=

# PostgreSQL
POSTGRES_ROOT_PASSWORD=
POSTGRES_AGENTE_PASSWORD=
POSTGRES_RAG_PASSWORD=

# MongoDB
MONGO_ROOT_USER=agente
MONGO_ROOT_PASSWORD=

# JWT de desenvolvimento: chave simétrica em Base64, com pelo menos 32 bytes.
# Pode ser a mesma exibida por: dotnet user-jwts key --project src/Api.Agente/Api.Agente.Endpoints
JWT_SIGNING_KEY_BASE64=
JWT_ISSUER=dotnet-user-jwts
